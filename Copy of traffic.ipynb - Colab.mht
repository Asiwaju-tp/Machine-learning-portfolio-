      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab-dark colab-dark" data-lang="notebook-python"><span><span class="mtk8">#&nbsp;PHASE&nbsp;2&nbsp;Model&nbsp;Building</span></span><br><span><span class="mtk1">number_of_classes&nbsp;=&nbsp;</span><span class="mtk17">len</span><span class="mtk14">(</span><span class="mtk1">sign_names</span><span class="mtk14">)</span></span><br><span><span></span></span><br><span><span class="mtk1">model&nbsp;=&nbsp;keras.Sequential</span><span class="mtk14">([</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;First&nbsp;Convolutional&nbsp;Block</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.Conv2D</span><span class="mtk14">(</span><span class="mtk6">32</span><span class="mtk14">,</span><span class="mtk1">&nbsp;</span><span class="mtk14">(</span><span class="mtk6">3</span><span class="mtk14">,</span><span class="mtk6">3</span><span class="mtk14">),</span><span class="mtk1">&nbsp;activation=</span><span class="mtk5">'relu'</span><span class="mtk14">,</span><span class="mtk1">&nbsp;input_shape=</span><span class="mtk14">(</span><span class="mtk6">32</span><span class="mtk14">,</span><span class="mtk6">32</span><span class="mtk14">,</span><span class="mtk6">3</span><span class="mtk14">)),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.MaxPooling2D</span><span class="mtk14">((</span><span class="mtk6">2</span><span class="mtk14">,</span><span class="mtk6">2</span><span class="mtk14">)),</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Second&nbsp;Convolutional&nbsp;Block</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.Conv2D</span><span class="mtk14">(</span><span class="mtk6">64</span><span class="mtk14">,(</span><span class="mtk6">3</span><span class="mtk14">,</span><span class="mtk6">3</span><span class="mtk14">),</span><span class="mtk1">&nbsp;activation=</span><span class="mtk5">"relu"</span><span class="mtk14">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.MaxPooling2D</span><span class="mtk14">((</span><span class="mtk6">2</span><span class="mtk14">,</span><span class="mtk6">2</span><span class="mtk14">)),</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#Third&nbsp;Convolutional&nbsp;Block</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.Conv2D</span><span class="mtk14">(</span><span class="mtk6">128</span><span class="mtk14">,(</span><span class="mtk6">3</span><span class="mtk14">,</span><span class="mtk6">3</span><span class="mtk14">),</span><span class="mtk1">&nbsp;activation=</span><span class="mtk5">"relu"</span><span class="mtk14">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.MaxPooling2D</span><span class="mtk14">((</span><span class="mtk6">2</span><span class="mtk14">,</span><span class="mtk6">2</span><span class="mtk14">)),</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Fully&nbsp;Connected&nbsp;Layers</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.Flatten</span><span class="mtk14">(),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.Dense</span><span class="mtk14">(</span><span class="mtk6">64</span><span class="mtk14">,</span><span class="mtk1">&nbsp;activation=</span><span class="mtk5">"relu"</span><span class="mtk14">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.Dropout</span><span class="mtk14">(</span><span class="mtk6">0.5</span><span class="mtk14">),</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Output&nbsp;Layer</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;layers.Dense</span><span class="mtk14">(</span><span class="mtk1">number_of_classes</span><span class="mtk14">,</span><span class="mtk1">&nbsp;activation=</span><span class="mtk5">"softmax"</span><span class="mtk14">)</span></span><br><span><span class="mtk14">])</span></span><br><span><span></span></span><br><span><span class="mtk1">model.</span><span class="mtk17">compile</span><span class="mtk14">(</span><span class="mtk1">optimizer=tf.keras.optimizers.Adam</span><span class="mtk14">(),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;loss=tf.keras.losses.SparseCategoric</span><span class="mtk1">alCrossentropy</span><span class="mtk14">(</span><span class="mtk1">from_logits=</span><span class="mtk9">False</span><span class="mtk14">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;metrics=</span><span class="mtk14">[</span><span class="mtk5">'accuracy'</span><span class="mtk14">])</span></span><br><span><span></span></span><br><span><span class="mtk17">print</span><span class="mtk14">(</span><span class="mtk5">"Model&nbsp;defined&nbsp;and&nbsp;compiled&nbsp;successfully."</span><span class="mtk14">)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowmode="open"><!----><div><!--?lit$215363836$-->Start coding or <span tabindex="0" role="button" class="link">generate</span> with AI.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
